{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Backend API (Bun)",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--watch", "src/index.ts"],
      "cwd": "backend",
      "port": 3000
    },
    {
      "name": "Frontend (Vite)",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "npm install && npm run dev"],
      "cwd": "frontend",
      "port": 5173
    }
  ]
}

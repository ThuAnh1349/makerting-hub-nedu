# ─────────────────────────────────────────────
# NEDU MARKETING HUB — Vercel Environment Variables
# Import file: Vercel Dashboard → Project → Settings → Environment Variables → Import .env
# ─────────────────────────────────────────────

# ── SUPABASE (Frontend + Backend) ────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ── DATABASE (Backend) ────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ── API URL (Frontend → Backend) ─────────────
# Sau khi deploy backend, điền URL Vercel của backend vào đây
VITE_API_URL=https://your-backend.vercel.app

# ── WEBHOOK SECRET (Lead sync từ ops.nedu.vn) ─
OPS_WEBHOOK_SECRET=YOUR_HMAC_WEBHOOK_SECRET_MIN_32_CHARS

# ── CLOUDFLARE STREAM (Video upload) ──────────
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_STREAM_TOKEN=YOUR_CLOUDFLARE_STREAM_API_TOKEN

# ── TELEGRAM BOT (Crisis alert) ───────────────
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CRISIS_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ── SMTP EMAIL (Thông báo qua email) ──────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=YOUR_APP_PASSWORD

# ── MOCK MODE (bật để xem UI demo không cần backend) ─
VITE_USE_MOCKS=true

# ── SERVER (Backend) ──────────────────────────
PORT=3000
NODE_ENV=production
